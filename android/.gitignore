# Generado por Android Studio / Gradle — nunca versionar.
*.iml
.gradle/
/local.properties
.idea/
.DS_Store
/build
/captures
.externalNativeBuildFmt/
.cxx/
local.properties

# Wrapper de Gradle: SÍ se versiona completo (gradlew, gradlew.bat,
# gradle/wrapper/gradle-wrapper.jar y gradle-wrapper.properties). Es lo que
# permite compilar en CI (GitHub Actions) y en cualquier máquina limpia sin
# tener Gradle/Android Studio instalado — ver .github/workflows/android-build.yml
# y android/README.md.

# Nunca debe existir ningún archivo con la credencial real de un
# dispositivo — se pega a mano en la app (EncryptedSharedPreferences),
# jamás en un archivo de este proyecto. Esta regla es defensiva: hoy no
# hay ningún archivo así, pero si alguna vez alguien crea uno para
# pruebas locales, no debe poder commitearse por accidente.
**/device-credential*.txt
**/*.secret
