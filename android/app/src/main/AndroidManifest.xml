<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para hablar con el backend EFAAT (POST /pagos/movimientos). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Usado por WorkManager para la constraint NetworkType.CONNECTED
         (reintento automático cuando vuelva internet). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Solo para poder disparar la notificación LOCAL de prueba (botón
         "Enviar notificación de prueba" en la pantalla principal) — no
         tiene relación con el acceso a notificaciones de otras apps, eso
         se gestiona aparte con el permiso especial de Notification
         Listener (no es un <uses-permission>, ver README). Obligatorio
         declararlo desde Android 13 (API 33) para poder postear una
         notificación propia. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EfaatPaymentsReaderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EfaatPaymentsReader"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic=true SOLO para permitir apuntar a un
             backend http:// en desarrollo local (p. ej. http://192.168.x.x:4000).
             En producción, apuntar la URL del backend a https:// y se
             puede quitar este flag (ver android/README.md). -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification Listener — el ÚNICO punto por el que la app lee
             notificaciones de OTRAS apps. Requiere que el usuario lo
             habilite manualmente en Ajustes (no hay diálogo de permiso
             runtime para esto, es una decisión de Android); MainActivity
             guía hacia esa pantalla de Ajustes. -->
        <service
            android:name=".listener.PaymentNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
